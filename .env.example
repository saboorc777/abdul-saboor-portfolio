# Points the frontend at your backend API. Leave as /api if using the Vite dev proxy.
VITE_API_URL=/api

# EmailJS (https://www.emailjs.com) — used by the Contact form.
# Leave blank during development; the form will simulate sending.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
